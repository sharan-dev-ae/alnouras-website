---
import '@fontsource-variable/manrope';
import '@fontsource-variable/dm-sans';
import '../styles/site.css';
import Icon from '../components/Icon.astro';
import { districts } from '../data/coverage';
const services = [
 { number: '01', name: 'Medical waste', icon: 'medical', text: 'Specialist collection for clinics, hospitals, laboratories and healthcare facilities.', tags: ['Healthcare facilities', 'Clinical waste'], photo: 'medical', image: 'https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?auto=format&fit=crop&w=900&q=85', alt: 'Illustrative hospital interior', detail: 'From healthcare facilities to laboratories, talk to our team about medical and pharmaceutical waste collection, separation requirements and an appropriate collection schedule.' },
 { number: '02', name: 'Construction waste', icon: 'building', text: 'Practical waste solutions that keep construction and demolition projects moving.', tags: ['Construction & demolition', 'Bulk collection'], photo: 'construction', image: '/images/alnouras-operations.webp', alt: 'An actual Alnouras skip collection vehicle at work', detail: 'Discuss your site access, material types, container requirements and collection frequency. Our existing services include construction and demolition waste, with a focus on recycling and repurposing where possible.' },
 { number: '03', name: 'General waste', icon: 'recycle', text: 'Dependable collection for businesses, residential communities and everyday operations.', tags: ['Commercial', 'Residential'], photo: 'general', image: '/images/alnouras-collection.webp', alt: 'An Alnouras uniformed team member operating a waste collection truck', detail: 'Scheduled or call-in collection for commercial and residential sites. Share your waste volumes and collection needs so the team can discuss the right arrangement for your property.' },
];
---
<!doctype html>
<html lang="en">
 <head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Al Nouras | Dubai Waste Collection & Transporting</title>
  <meta name="description" content="Over 30 years of waste management experience in Dubai. Al Nouras provides medical, construction, commercial and residential waste collection and transporting."/>
  <meta name="theme-color" content="#082d68"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <link rel="preload" as="image" href="/images/alnouras-hero.webp" fetchpriority="high"/>
  <script is:inline>document.documentElement.classList.add('js');</script>
 </head>
 <body>
  <a href="#main" class="skip">Skip to content</a><div class="scroll-progress" aria-hidden="true"></div>
  <div class="utility-bar"><div class="container utility-inner"><span><Icon name="shield" size={14}/> Dubai Municipality approved waste transporting company</span><a href="mailto:info@alnouras.com">info@alnouras.com <Icon name="diagonal" size={12}/></a><a href="tel:+97143338339"><Icon name="phone" size={13}/> +971 4 333 8339</a></div></div>
  <header class="site-header"><div class="container nav-inner"><a class="brand" href="#" aria-label="Al Nouras home"><span class="brand-mark"><Icon name="recycle" size={33}/></span><span class="brand-name">al<span>nouras</span><small>WASTE COLLECTION & TRANSPORTING</small></span></a><nav id="navigation" aria-label="Main navigation"><a href="#services">Our services</a><a href="#coverage">Dubai coverage</a><a href="#fleet">Our fleet</a><a href="#about">About us</a></nav><a class="button button-blue nav-quote" href="#contact">Get a free quote <Icon name="diagonal" size={17}/></a><button class="menu-toggle icon-button" aria-label="Open navigation" aria-expanded="false" aria-controls="navigation"><Icon name="menu"/></button></div></header>
  <main id="main">
   <section class="hero" aria-labelledby="hero-title">
    <div class="hero-image" aria-hidden="true"><img src="/images/alnouras-hero.webp" alt="" width="1920" height="1080" fetchpriority="high"/></div><div class="hero-shade"></div><div class="hero-grid" aria-hidden="true"></div>
    <div class="container hero-content"><div class="hero-copy"><span class="eyebrow hero-eyebrow"><span class="status-dot"></span> YOUR CITY. OUR COMMITMENT.</span><h1 id="hero-title">Your waste.<br/>Our <span>responsibility.</span></h1><p>Keeping Dubai cleaner for over 30 years.<br/>Professional waste collection. People you can count on.<br class="desktop-break"/> A service built around your business.</p><div class="hero-actions"><a class="button button-yellow" href="#contact">Let’s get it collected <Icon name="diagonal" size={19}/></a><a class="hero-secondary" href="#coverage"><span><Icon name="pin" size={18}/></span> Explore our coverage</a></div><div class="hero-assurances"><span><Icon name="check" size={14}/> Experienced teams</span><span><Icon name="check" size={14}/> Competitive rates</span><span><Icon name="check" size={14}/> Dubai-wide enquiries</span></div></div>
     <div class="hero-photo-tag"><span class="photo-tag-icon"><Icon name="truck" size={25}/></span><div><strong>Real fleet. Real commitment.</strong><span>AL NOURAS · DUBAI, UAE</span></div><Icon name="diagonal" size={19}/></div>
     <a href="#services" class="hero-scroll"><span>SCROLL TO DISCOVER</span><span class="scroll-line"></span></a><div class="hero-caption">OUR PEOPLE. OUR VEHICLES. OUR CITY.<span>Photography from the Al Nouras archive.</span></div>
    </div>
   </section>
   <section class="stats-bar" aria-label="Company at a glance"><div class="container stats-grid"><div class="stat"><span class="stat-icon"><Icon name="shield"/></span><div><strong><span data-count="30">30</span>+</strong><span>Years of experience</span></div></div><div class="stat"><span class="stat-icon"><Icon name="people"/></span><div><strong><span data-count="1200">1,200</span>+ <small>DEMO</small></strong><span>Illustrative client total</span></div></div><div class="stat"><span class="stat-icon"><Icon name="truck"/></span><div><strong><span data-count="60">60</span>+ <small>DEMO</small></strong><span>Illustrative fleet total</span></div></div><div class="stat"><span class="stat-icon"><Icon name="clock"/></span><div><strong>24/7</strong><span>Enquiry access, on your schedule</span></div></div></div></section>
   <section id="services" class="services section-pad"><div class="container"><div class="section-heading reveal"><div><span class="eyebrow blue-eyebrow"><span class="tiny-square"></span> WASTE SOLUTIONS, WITHOUT THE COMPLICATIONS</span><h2>Whatever your industry.<br/><span>We take care of it.</span></h2></div><p>From the first collection to your ongoing needs, we make waste management one less thing to think about.</p></div><div class="service-grid">{services.map(service=><article class={`service-card reveal ${service.photo}`}><div class="service-image"><img src={service.image} alt={service.alt} loading="lazy" width="900" height="650"/><span class="service-num">{service.number} /</span><span class="service-icon"><Icon name={service.icon} size={25}/></span></div><div class="service-body"><h3>{service.name}</h3><p>{service.text}</p><div class="service-tags">{service.tags.map(tag=><span>{tag}</span>)}</div><button class="service-link" data-service-dialog={service.number}>Explore service <Icon name="diagonal" size={18}/></button></div></article>)}</div><div class="services-footnote"><span><Icon name="recycle" size={19}/> Also supporting industrial, hazardous and pharmaceutical waste requirements.</span><a href="#contact">Find your solution <Icon name="arrow" size={17}/></a></div></div></section>
   <section id="coverage" class="coverage-section section-pad"><div class="container"><div class="section-heading reveal"><div><span class="eyebrow blue-eyebrow"><span class="tiny-square"></span> CLOSE TO YOU. ACROSS DUBAI.</span><h2>A city that never stops.<br/><span>A team that keeps moving.</span></h2></div><p>From Jebel Ali to Al Qusais, explore Dubai districts and see how a connected collection network could look.</p></div>
    <div class="coverage-dashboard reveal"><div class="map-toolbar"><div class="map-title"><Icon name="pin" size={19}/><strong>Dubai service coverage</strong><span class="demo-tag">INTERACTIVE PREVIEW</span></div><div class="map-filters" role="group" aria-label="Filter demonstration collections"><button data-filter="all" aria-pressed="true">All areas</button><button data-filter="Medical waste" aria-pressed="false">Medical</button><button data-filter="Construction waste" aria-pressed="false">Construction</button><button data-filter="General waste" aria-pressed="false">General</button></div></div>
     <div class="map-dashboard-body"><div class="map-stage"><div class="map-fallback" aria-hidden="true"><svg viewBox="0 0 900 620" preserveAspectRatio="xMidYMid slice"><rect width="900" height="620" fill="#edf0e9"/><path d="M0 0H760L600 100 460 190 310 300 170 430 0 480Z" fill="#ccdee6"/><g fill="none" stroke="#fff" stroke-width="5"><path d="m80 610 200-250 250-170 350-120M160 620l250-260L780 120M360 620l110-210L880 200M0 490l380-110 500 20M300 620l80-250 120-170"/><path d="M50 580 300 350 600 170 890 100" stroke="#e8c798" stroke-width="10"/></g><g font-family="Arial" font-size="17" fill="#647487"><text x="90" y="170">ARABIAN GULF</text><text x="330" y="290">DUBAI</text><text x="160" y="510">Jebel Ali</text><text x="570" y="190">Deira</text><text x="550" y="450">Dubai Silicon Oasis</text></g></svg><span>Dubai coverage overview · schematic</span></div><div id="dubai-map" aria-label="Interactive map of illustrative Dubai service locations"></div><div class="map-overlay-badge"><span class="red-dot"></span> <span id="area-count">12</span> featured districts</div><button id="reset-map" class="map-reset" aria-label="Reset map to all Dubai locations"><Icon name="target" size={17}/><span>Recenter</span></button><div class="map-legend"><span><i class="legend-pin"></i> Sample collection point</span><span><i class="legend-route"></i> Illustrative connection</span></div></div>
      <aside class="activity-panel" aria-label="Simulated collection activity"><div class="activity-heading"><div><span class="eyebrow">COLLECTION ACTIVITY</span><h3>On the move<span class="status-dot"></span></h3></div><button id="toggle-activity" class="icon-button" aria-label="Pause demo activity" aria-pressed="false"><Icon name="pause" size={17}/></button></div><div class="simulation-label"><span class="red-dot"></span> LIVE-STYLE DEMO <span id="demo-clock">SIMULATED</span></div><div class="activity-summary"><strong id="active-count">12</strong><span>sample collection points<br/>across Dubai</span><span class="activity-spark" aria-hidden="true">▁▃▂▅▄▆▃█</span></div><div class="activity-list" id="activity-list">{districts.slice(0,3).map((area,i)=><button class:list={['activity-item',{selected:i===0}]} data-area={area.name}><span class="activity-truck"><Icon name="truck" size={18}/></span><span><strong>{area.name}</strong><small>{area.service} · {area.vehicle}</small><span class="activity-state"><i></i>{area.state}</span></span><Icon name="chevron" size={14}/></button>)}</div><div class="activity-bottom"><span><Icon name="shield" size={14}/> No real customer or vehicle locations</span><a href="#contact">Need a collection? Let’s talk <Icon name="arrow" size={15}/></a></div></aside>
     </div><div class="dashboard-disclaimer"><Icon name="info" size={14}/><p>Illustrative coverage and simulated pickups, not live tracking or confirmed routes. Service availability is confirmed by our team for your location.</p></div>
    </div><div class="district-strip"><span>YOUR NEIGHBOURHOOD?</span>{['Downtown Dubai','Business Bay','Jebel Ali','Al Quoz','Dubai Marina','Al Qusais'].map(name=><button data-area={name}>{name}<Icon name="diagonal" size={12}/></button>)}</div>
   </div></section>
   <section id="fleet" class="fleet-section section-pad"><div class="container"><div class="section-heading reveal"><div><span class="eyebrow blue-eyebrow"><span class="tiny-square"></span> THE FLEET BEHIND THE FOLLOW-THROUGH</span><h2>Serious equipment.<br/><span>Even better people.</span></h2></div><p>Purpose-built collection vehicles and professional, uniformed teams. The right approach from arrival to the final collection.</p></div><div class="fleet-gallery"><figure class="fleet-main reveal"><img src="/images/alnouras-fleet.webp" alt="Alnouras Hino collection truck from the company's fleet" loading="lazy" width="1920" height="725"/><figcaption><span class="eyebrow">BUILT FOR THE JOB</span><strong>Ready for the work ahead.</strong><span>Waste collection & transporting</span></figcaption><span class="photo-counter">01 / THE FLEET</span></figure><figure class="fleet-team reveal"><img src="/images/alnouras-collection.webp" alt="An Alnouras team member with gloves and mask operating the collection truck" loading="lazy" width="1920" height="725"/><figcaption><Icon name="people" size={24}/><span>People you can<br/><strong>count on.</strong></span></figcaption></figure><div class="fleet-promise reveal"><span class="eyebrow">PROFESSIONAL, THROUGH AND THROUGH</span><h3>A proper setup.<br/>Every collection.</h3><ul><li><Icon name="check" size={16}/> Purpose-built waste collection vehicles</li><li><Icon name="check" size={16}/> Trained, uniformed drivers and crews</li><li><Icon name="check" size={16}/> Collection plans suited to your operation</li></ul><a href="#contact">Discuss your collection needs <Icon name="diagonal" size={17}/></a></div></div></div></section>
   <section class="value-section"><div class="container value-inner"><div class="value-title reveal"><span class="eyebrow">BETTER SERVICE. SENSIBLE VALUE.</span><h2>Big on care.<br/><span>Fair on price.</span></h2><p>Get a competitive quote built around your waste type, volume and collection schedule. Clear scope. Practical options. No guesswork.</p><a href="#contact" class="button button-blue">Get your tailored quote <Icon name="diagonal" size={19}/></a></div><div class="value-features"><div class="value-feature reveal"><Icon name="shield" size={30}/><div><h3>Quality that starts with people.</h3><p>Experienced teams and an environmentally responsible approach to waste collection.</p></div></div><div class="value-feature reveal"><Icon name="clock" size={30}/><div><h3>Your business has its own clock.</h3><p>Send an enquiry 24/7. Discuss out-of-hours collection options and availability with the team.</p></div></div><div class="value-feature reveal"><Icon name="recycle" size={30}/><div><h3>The right service. The right value.</h3><p>A collection arrangement that fits your site, without paying for a one-size-fits-all solution.</p></div></div></div></div></section>
   <section id="about" class="about-section section-pad"><div class="container about-grid"><div class="about-visual reveal"><img src="/images/alnouras-operations.webp" alt="Alnouras truck and crew handling a skip collection in Dubai" loading="lazy" width="1920" height="725"/><div class="heritage-stamp"><strong>30<span>+</span></strong><span>YEARS OF<br/>LOCAL EXPERIENCE</span></div><span class="image-caption">AL NOURAS AT WORK · DUBAI</span></div><div class="about-copy reveal"><span class="eyebrow blue-eyebrow"><span class="tiny-square"></span> DUBAI IS HOME</span><h2>Part of this city.<br/><span>For the long run.</span></h2><p class="about-lead">Dubai has changed. Our commitment to keeping it clean hasn’t.</p><p>Al Nouras Waste Collection & Transporting LLC brings over three decades of experience to the work behind a cleaner city. From healthcare facilities to construction sites and residential communities, we help businesses manage their waste with confidence.</p><div class="about-facts"><span><Icon name="shield" size={20}/> Dubai Municipality approved<br/>waste transporting company</span><span><Icon name="pin" size={20}/> Locally based.<br/>Focused on Dubai.</span></div><a class="text-link" href="https://www.alnouras.com/" target="_blank" rel="noopener noreferrer">Explore our company background <Icon name="diagonal" size={17}/></a></div></div></section>
   <section id="contact" class="contact-section section-pad"><div class="container contact-grid"><div class="contact-copy reveal"><span class="eyebrow"><span class="tiny-square"></span> LET’S TAKE IT FROM HERE</span><h2>A cleaner site.<br/>A lighter workload.<br/><span>One conversation.</span></h2><p>Tell us what you need collected.<br/>We’ll help you work out the next step.</p><a class="contact-detail" href="tel:+97143338339"><span><Icon name="phone" size={21}/></span><div><small>GIVE US A CALL</small><strong>+971 4 333 8339</strong></div><Icon name="diagonal" size={20}/></a><a class="contact-detail" href="mailto:info@alnouras.com"><span><Icon name="mail" size={21}/></span><div><small>DROP US A LINE, ANY TIME</small><strong>info@alnouras.com</strong></div><Icon name="diagonal" size={20}/></a><span class="contact-location"><Icon name="pin" size={16}/> Dubai, United Arab Emirates</span></div><form class="enquiry-form reveal"><div class="form-title"><h3>Let’s find your solution.</h3><p>A few details. A more useful conversation.</p></div><div class="form-row"><label>Your name<input name="name" placeholder="Full name" autocomplete="name" required maxlength="100"/></label><label>Company<input name="company" placeholder="Company name" autocomplete="organization" maxlength="150"/></label></div><div class="form-row"><label>Email address<input name="email" type="email" placeholder="you@company.com" autocomplete="email" required maxlength="200"/></label><label>Phone number<input name="phone" type="tel" placeholder="+971" autocomplete="tel" maxlength="40"/></label></div><div class="form-row"><label>Service required<select name="service" id="service" required><option value="">Select a service</option>{services.map(s=><option>{s.name}</option>)}<option>Hazardous & pharmaceutical waste</option><option>Other / not sure yet</option></select></label><label>Location in Dubai<input name="location" id="enquiry-location" placeholder="Area or district" autocomplete="address-level2" required maxlength="150"/></label></div><label>How can we help?<textarea name="message" rows="3" placeholder="Waste type, approximate volume, collection frequency…" required maxlength="3000"></textarea></label><button class="button button-yellow" type="submit">Prepare my enquiry <Icon name="diagonal" size={19}/></button><p class="form-note"><Icon name="mail" size={13}/> Prepare an email to review and send in your email app.</p><div class="form-result" role="status" hidden><strong>Your enquiry is prepared.</strong><p>Review it and send it to info@alnouras.com.</p><a class="email-enquiry button button-blue">Open email app <Icon name="diagonal" size={16}/></a><a class="download-enquiry" download="alnouras-enquiry.txt">Download a copy <Icon name="arrow" size={14}/></a></div></form></div></section>
  </main>
  <footer class="site-footer"><div class="container"><div class="footer-top"><a class="brand" href="#"><span class="brand-mark"><Icon name="recycle" size={31}/></span><span class="brand-name">al<span>nouras</span><small>WASTE COLLECTION & TRANSPORTING</small></span></a><p>A cleaner Dubai.<br/><strong>A shared responsibility.</strong></p><div class="footer-nav"><a href="#services">Our services</a><a href="#coverage">Dubai coverage</a><a href="#fleet">Our fleet</a><a href="#contact">Get in touch</a></div><a href="#" class="back-top" aria-label="Back to top"><Icon name="diagonal" size={24}/></a></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Al Nouras Waste Collection & Transporting LLC.</span><span>Dubai, UAE <span class="uae-colors" aria-label="United Arab Emirates flag colours"></span></span><a href="https://www.alnouras.com/" target="_blank" rel="noopener noreferrer">Company information source <Icon name="diagonal" size={12}/></a></div></div></footer>
  {services.map(service=><dialog class="service-dialog" id={`service-${service.number}`} aria-labelledby={`dialog-title-${service.number}`}><button class="dialog-close icon-button" aria-label="Close service details"><Icon name="close"/></button><span class="dialog-icon"><Icon name={service.icon} size={34}/></span><span class="eyebrow blue-eyebrow">AL NOURAS WASTE SOLUTIONS</span><h2 id={`dialog-title-${service.number}`}>{service.name}</h2><p>{service.detail}</p><a class="button button-yellow dialog-quote" data-quote-service={service.name} href="#contact">Discuss this service <Icon name="diagonal" size={18}/></a></dialog>)}
  <script src="../scripts/main.ts"></script>
 </body>
</html>
