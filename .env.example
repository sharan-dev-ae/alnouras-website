# NASA Blue Marble is the key-free, global-resolution development imagery.
PUBLIC_SATELLITE_IMAGERY_PROVIDER=nasa

# Optional: select 'ion' above for an imagery asset licensed in YOUR Cesium ion account.
# These values are delivered to the browser; never use an admin/server token.
# Limit the token to assets:read, the chosen imagery asset, and allowed app URLs.
# Configure local preview and production URLs separately in the provider dashboard.
PUBLIC_CESIUM_ION_TOKEN=
PUBLIC_CESIUM_IMAGERY_ASSET_ID=
